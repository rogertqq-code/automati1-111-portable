# ── Persistent operator state (must survive code updates) ────────────────────
# These files accumulate across runs and encode permanent decisions (which
# accounts/proxies/fingerprints are dead) or in-flight progress. They are
# gitignored so `git pull` / redeploys never overwrite them.
live-test-progress.json
proxy-scores.json
misdirection-denylist.json
email-denylist.json
bot-block-cooldown.json
config/misdirection-denylist.json
config/email-denylist.json

# ── Databases (credentials, test results, run history) ───────────────────────
# SQLite databases store all imported credentials and their test outcomes.
# Must NEVER be overwritten by git pull / checkout / reset.
data/
backups/
credentials/
permdisabled/
brain.db
*.sqlite
human-verdicts.jsonl
progress.json
credentials-results.xlsx

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
.aider*

# ── Test artifacts (regenerated every run) ───────────────────────────────────
coverage/
playwright-report/
test-results/

