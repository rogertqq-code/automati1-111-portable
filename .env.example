# ── Application Secrets ───────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# All secret variables below are also stored in GitHub Secrets for CI/CD.
# See: Settings → Secrets and variables → Actions
#
# NEVER commit actual values to version control.

# ── Spider / Proxy (GitHub Secret) ────────────────────────────────────────────
SPIDER_API_KEY=
SPIDER_LOCAL_API_KEY=
PRIMARY_PROXY_URL=
EXTERNAL_PROXY_POOL=
PROXY_ROTATE_URL_TEMPLATE=

# ── AI / LLM API Keys (GitHub Secret) ────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ── Google Cloud Storage — screenshot archival (GitHub Secret) ────────────────
GCS_BUCKET=
GCS_KEY_FILE=
GCS_ACCESS_KEY=
GCS_SECRET_KEY=
GCS_PROJECT_ID=
GCS_PATH_PREFIX=
GCS_ENABLED=

# ── Redis — Wicketkeeper token farm (GitHub Secret) ───────────────────────────
REDIS_URL=

# ── Local Config (non-secret, NOT stored in GitHub Secrets) ───────────────────
ENGINE_CONFIG=
TEST_CREDS=
PORT=
LOG_LEVEL=
CLOAK_PROFILE_DIR=
CLOAK_RECORD_VIDEO=
CLOAK_REUSE_PROFILES=

# ── CI-only tokens (configured once in GitHub Secrets) ────────────────────────
# GITHUB_TOKEN      — Automatically provided by GitHub Actions
# TESTDINO_TOKEN    — TestDino reporting token
# QODANA_TOKEN      — JetBrains Qodana analysis token
